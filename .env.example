# Secure server-only admin settings.
# Create a password hash with: npm run admin:hash
# Create a session secret with: npm run admin:secret
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional public build-time setting; blank uses the current site URL.
VITE_SITE_URL=

# Optional Node server settings (defaults: port 3000, loopback in development).
PORT=
HOST=
