# Client reviews are maintained in lib/client-reviews.ts; no Google API key is required.

# Comma-separated ChatGPT account emails allowed to manage salon bookings.
# Keep this value private in .env or configure it in Sites runtime settings.
ADMIN_EMAILS=

# Optional public build-time setting; blank uses the current site URL.
VITE_SITE_URL=

# Optional Node server settings (defaults: port 3000, loopback in development).
PORT=
HOST=